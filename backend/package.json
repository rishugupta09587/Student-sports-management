  "devDependencies": {
    "@types/compression": "^1.7.5",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/morgan": "^1.9.9",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.10.5",
    "@types/streamifier": "^0.1.2",
    "eslint": "^9.19.0",
    "mongodb-memory-server": "^11.2.0",
    "tsx": "^4.19.2",
